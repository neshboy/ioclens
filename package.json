{
  "name": "ioclens",
  "version": "0.1.0",
  "description": "Self-hostable IOC (Indicator of Compromise) enrichment engine: cross-references an IP, domain, or file hash against real open OSINT sources in a single pass and returns one scored, explained verdict.",
  "type": "module",
  "license": "MIT",
  "author": "IOCLens contributors",
  "bin": {
    "ioclens": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "live-check": "tsx scripts/live-check.mts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.1"
  }
}
